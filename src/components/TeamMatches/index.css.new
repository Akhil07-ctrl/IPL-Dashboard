/* Write your CSS here */
.team-matches-container {
  display: flex;
  justify-content: center;
  min-height: 100vh;
  padding: 10px;
}

.text-decoration-none {
  text-decoration: none;
}  

.rcb {
  background: linear-gradient(to top, #1e293b, #a4261d);
}

.kkr {
  background: linear-gradient(to top, #1e293b, #5755a7);
}

.kxp {
  background: linear-gradient(to top, #1e293b, #d91c1f);
}

.csk {
  background: linear-gradient(to top, #1e293b, #f7db00);
}

.rr {
  background: linear-gradient(to top, #1e293b, #da237b);
}

.mi {
  background: linear-gradient(to top, #1e293b, #13418b);
}

.srh {
  background: linear-gradient(to top, #1e293b, #f26d22);
}

.dc {
  background: linear-gradient(to top, #1e293b, #4f5db0);
}

.responsive-container {
  width: 95%;
  max-width: 500px;
  margin-top: 20px;
  padding: 15px;
}

.team-banner {
  width: 100%;
  border-radius: 8px;
}

.recent-matches-list {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  padding-left: 0;
  margin-top: 20px;
  gap: 10px;
}

.latest-match-heading {
  color: #ffffff;
  font-family: 'Bree Serif', serif;
  font-size: 20px;
  font-weight: 500;
  text-align: center;
  margin-bottom: 15px;
}

.back-button {
  display: block;
  margin: 25px auto;
  padding: 10px 20px;
  font-size: 14px;
  font-weight: 600;
  border-radius: 8px;
  transition: all 0.3s ease;
  background-color: transparent;
  color: #3b82f6;
  border: 2px solid #3b82f6;
  text-transform: uppercase;
  letter-spacing: 1px;
  position: relative;
  overflow: hidden;
  z-index: 1;
  cursor: pointer;
  text-decoration: none;
}

.back-button:hover {
  transform: translateY(-3px);
  box-shadow: 0 6px 12px rgba(59, 130, 246, 0.3);
  color: white;
  background-color: #3b82f6;
}

.back-button:active {
  transform: translateY(-1px);
  box-shadow: 0 3px 6px rgba(59, 130, 246, 0.2);
}

/* Small devices (phones, 576px and up) */
@media screen and (min-width: 576px) {
  .responsive-container {
    margin-top: 30px;
  }
  
  .latest-match-heading {
    font-size: 22px;
  }
  
  .back-button {
    padding: 10px 22px;
    font-size: 15px;
  }
}

/* Medium devices (tablets, 768px and up) */
@media screen and (min-width: 768px) {
  .responsive-container {
    margin-top: 60px;
    max-width: 720px;
    padding: 20px;
  }
  
  .recent-matches-list {
    margin-top: 32px;
    justify-content: space-between;
    gap: 15px;
  }
  
  .latest-match-heading {
    font-size: 24px;
  }
  
  .back-button {
    margin: 30px auto;
    padding: 12px 25px;
    font-size: 16px;
  }
}

/* Large devices (desktops, 992px and up) */
@media screen and (min-width: 992px) {
  .responsive-container {
    max-width: 960px;
    margin-top: 80px;
  }
}

/* Extra large devices (large desktops, 1200px and up) */
@media screen and (min-width: 1200px) {
  .responsive-container {
    max-width: 1110px;
    margin-top: 96px;
  }
}